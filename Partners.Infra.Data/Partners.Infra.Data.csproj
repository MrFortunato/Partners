<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Em Arquitetura Limpa, a camada de Infraestrutura só conhece o Domínio.
       A referência anterior a Partners.Aplication era uma violação da regra de dependências. -->
  <ItemGroup>
    <ProjectReference Include="..\Partners.Domain\Partners.Domain.csproj" />
  </ItemGroup>

</Project>
